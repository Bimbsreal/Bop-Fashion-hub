# Copy to .env and fill in a local database you control.
# Do not commit .env. Do not put production credentials here.
PORT=5000
DATABASE_URL=postgres://USER@127.0.0.1:5432/bop
MEDIA_STORAGE_DIR=.local/media
MEDIA_MAX_BYTES=8388608

# AI orchestration stays local. Leave the test provider and worker off unless you are exercising them.
# Do not put provider API keys in this file.
AI_TEST_PROVIDER=0
AI_WORKER=0
AI_TASK_MAX_ATTEMPTS=3
AI_TASK_TIMEOUT_MS=10000
AI_TASK_BACKOFF_MS=200
AI_STALE_RUNNING_MS=120000
AI_MAX_TASKS_PER_MINUTE=30

# Local payment simulation. Leave this off unless you are exercising the development adapter.
# It never charges a card. It stays off when NODE_ENV=production.
PAYMENT_SIMULATION=0
